<UserControl
    x:Class="FluentBrowser.Controls.ScrollableItemsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <ScrollViewer
        x:Name="ItemsScrollViewer"
        BringIntoViewOnFocusChange="True"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Enabled"
        IsDeferredScrollingEnabled="False"
        IsHorizontalRailEnabled="False"
        IsVerticalRailEnabled="False"
        Loaded="ItemsScrollViewer_Loaded"
        SizeChanged="ItemsScrollViewer_SizeChanged"
        Style="{StaticResource ScrollableItemsScrollViewerStyle}"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled"
        ViewChanged="ItemsScrollViewer_ViewChanged"
        ZoomMode="Disabled">

        <ItemsControl
            x:Name="ItemsList"
            ItemContainerTransitions="{Binding ItemContainerTransitions, ElementName=Root}"
            ItemTemplate="{Binding ItemTemplate, ElementName=Root}"
            ItemsPanel="{Binding ItemsPanel, ElementName=Root}"
            ItemsSource="{Binding ItemsSource, ElementName=Root}"
            SizeChanged="ItemsList_SizeChanged" />
    </ScrollViewer>
</UserControl>