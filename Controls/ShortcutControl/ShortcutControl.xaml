<UserControl
    x:Class="FluentBrowser.Controls.ShortcutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="220"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Right">

        <Button
            x:Name="EditButton"
            Padding="1"
            HorizontalAlignment="Right"
            AutomationProperties.Name="Activation shortcut"
            Style="{ThemeResource AppBarButtonStyle}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Click="OpenDialogButton_Click">

            <StackPanel Orientation="Horizontal" Spacing="4">

                <ItemsControl
                    x:Name="PreviewKeysControl"
                    Margin="2"
                    VerticalAlignment="Center"
                    IsTabStop="False"
                    ItemsSource="{x:Bind PreviewKeys}"
                    Visibility="Collapsed">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="36"
                                MinHeight="32"
                                Padding="9,6,9,7"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">

                                <Grid>
                                    <Border
                                        BorderBrush="{ThemeResource AccentButtonBorderBrush}"
                                        BorderThickness="1"
                                        Margin="-9,-6,-9,-7"
                                        CornerRadius="{ThemeResource ControlCornerRadius}" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{Binding FontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="{Binding Text}" />

                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource Windows14}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Visibility="{Binding IsWindowsKey, Converter={StaticResource ValueToVisibilityConverter}}" />
                                </Grid>

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <StackPanel
                    x:Name="PlaceholderPanel"
                    Padding="8,4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Orientation="Horizontal"
                    Spacing="8">

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Text="&#xE710;" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Configure shortcut" />

                </StackPanel>

                <TextBlock
                    x:Name="EditIcon"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="&#xE70F;"
                    Visibility="Collapsed" />

            </StackPanel>
        </Button>

    </Grid>

</UserControl>