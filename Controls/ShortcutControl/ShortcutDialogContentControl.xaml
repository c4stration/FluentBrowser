<UserControl
    x:Class="FluentBrowser.Controls.ShortcutDialogContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ShortcutContentControl"
    IsTabStop="True"
    TabIndex="0"
    mc:Ignorable="d">

    <Grid
        MinWidth="498"
        MinHeight="220"
        RowSpacing="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="DescriptionTextBlock"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Press a combination of keys to change this shortcut."
            TextWrapping="Wrap" />

        <Grid
            Grid.Row="1"
            MinHeight="104"
            Margin="0,16,0,0"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            CornerRadius="8">

            <ItemsControl
                x:Name="KeysControl"
                Height="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                ItemsSource="{x:Bind Keys}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            MinWidth="48"
                            Padding="20,16"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">

                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{Binding FontFamily}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{Binding Text}" />

                                <PathIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Windows16}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Visibility="{Binding IsWindowsKey, Converter={StaticResource ValueToVisibilityConverter}}" />
                            </Grid>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <TextBlock
                x:Name="NoKeysText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Press a combination of keys to change this shortcut."
                TextAlignment="Center" />

        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">

            <HyperlinkButton
                x:Name="ResetBtn"
                Padding="0"
                Click="ResetBtn_Click">

                <StackPanel Orientation="Horizontal" Spacing="4">

                    <FontIcon FontSize="10" Glyph="&#xE777;" />

                    <TextBlock FontSize="12" Text="Reset" />

                </StackPanel>

            </HyperlinkButton>

            <HyperlinkButton
                x:Name="ClearBtn"
                Padding="0"
                Click="ClearBtn_Click">

                <StackPanel Orientation="Horizontal" Spacing="4">

                    <FontIcon FontSize="12" Glyph="&#xE894;" />

                    <TextBlock FontSize="12" Text="Clear" />

                </StackPanel>

            </HyperlinkButton>

        </StackPanel>

        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            Spacing="8">

            <InfoBar
                x:Name="InvalidShortcutBar"
                Title="Invalid shortcut"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="{x:Bind IsError, Mode=OneWay}"
                Message="A shortcut should start with Windows key, Ctrl, Alt or Shift and contain another key."
                Severity="Error" />

            <InfoBar
                x:Name="AltGrWarningBar"
                Title="Possible shortcut interference with Alt Gr"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="{x:Bind IsWarningAltGr, Mode=OneWay}"
                Message="This shortcut uses Ctrl + Alt without the Windows key."
                Severity="Warning" />

            <InfoBar
                x:Name="ConflictBar"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="{x:Bind HasConflict, Mode=OneWay}"
                Message="{x:Bind ConflictMessage, Mode=OneWay}"
                Severity="Warning" />

        </StackPanel>

    </Grid>

</UserControl>