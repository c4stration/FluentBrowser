<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:l="using:WinUI3Localizer"
    xmlns:my="using:FluentBrowser.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style
                x:Key="AddressBarTextBoxStyle"
                BasedOn="{StaticResource DefaultTextBoxStyle}"
                TargetType="TextBox">

                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="12,6,36,4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="32" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="BrowserChrome"
            Grid.Row="0"
            Canvas.ZIndex="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <SystemBackdropElement
                x:Name="BrowserChromeMica"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
                <SystemBackdropElement.SystemBackdrop>
                    <MicaBackdrop Kind="Base" />
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>

            <TabView
                x:Name="MainTabView"
                Grid.Row="0"
                x:FieldModifier="public"
                AddTabButtonClick="TabView_AddButtonClick"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                SelectionChanged="MainTabView_SelectionChanged"
                TabCloseRequested="TabView_TabCloseRequested">

                <TabView.Resources>
                    <MenuFlyout x:Key="TabContextMenu" Opening="TabContextMenu_Opening">

                        <MenuFlyoutItem
                            l:Uids.Uid="TabContextReopenClosed"
                            Click="TabContextMenu_Click"
                            Tag="reopen">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem
                            l:Uids.Uid="TabContextRefresh"
                            Click="TabContextMenu_Click"
                            Tag="refresh">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            l:Uids.Uid="TabContextDuplicate"
                            Click="TabContextMenu_Click"
                            Tag="duplicate">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEB91;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem
                            l:Uids.Uid="TabContextClose"
                            Click="TabContextMenu_Click"
                            Tag="close">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            l:Uids.Uid="TabContextCloseOther"
                            Click="TabContextMenu_Click"
                            Tag="closeOther" />

                        <MenuFlyoutItem
                            l:Uids.Uid="TabContextCloseRight"
                            Click="TabContextMenu_Click"
                            Tag="closeRight" />

                    </MenuFlyout>

                    <Style TargetType="TabViewItem">
                        <Setter Property="ContextFlyout" Value="{StaticResource TabContextMenu}" />
                    </Style>
                </TabView.Resources>

                <TabView.TabStripFooter>
                    <Grid
                        x:Name="DragRegion"
                        MinWidth="100"
                        IsHitTestVisible="False" />
                </TabView.TabStripFooter>

            </TabView>

            <!--  ADDRESS BAR  -->
            <Grid
                x:Name="Toolbar"
                Grid.Row="1"
                Padding="12,6,12,7"
                Background="Transparent">

                <!--<Grid.BackgroundTransition>
                    <BrushTransition />
                </Grid.BackgroundTransition>-->

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">

                    <Button
                        x:Name="BackButton"
                        Margin="0,2,5,0"
                        Padding="3,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="BackButton_Click"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Style="{StaticResource AppBarButtonStyle}">
                        <ToolTipService.ToolTip>
                            <StackPanel>
                                <TextBlock
                                    l:Uids.Uid="BackButtonTooltipTitle"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock l:Uids.Uid="BackButtonTooltipDescription" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </ToolTipService.ToolTip>

                        <AnimatedIcon Width="18" Height="18">
                            <AnimatedIcon.Source>
                                <a:AnimatedChevronDownSmallVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </AnimatedIcon.RenderTransform>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>

                    <Button
                        x:Name="ForwardButton"
                        Margin="0,2,5,0"
                        Padding="3,6"
                        VerticalAlignment="Center"
                        Click="ForwardButton_Click"
                        ClickMode="Release"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Style="{StaticResource AppBarButtonStyle}">
                        <ToolTipService.ToolTip>
                            <StackPanel>
                                <TextBlock
                                    l:Uids.Uid="ForwardButtonTooltipTitle"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock l:Uids.Uid="ForwardButtonTooltipDescription" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </ToolTipService.ToolTip>
                        <AnimatedIcon Width="18" Height="18">
                            <AnimatedIcon.Source>
                                <a:AnimatedChevronDownSmallVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </AnimatedIcon.RenderTransform>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </StackPanel>

                <AutoSuggestBox
                    x:Name="AddressBar"
                    Grid.Column="1"
                    Height="32"
                    Margin="0,2"
                    VerticalContentAlignment="Center"
                    l:Uids.Uid="AddressBar"
                    BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CharacterSpacing="1"
                    CornerRadius="8"
                    FontSize="13"
                    FontWeight="Medium"
                    GotFocus="AddressBar_GotFocus"
                    Loaded="AddressBar_Loaded"
                    LostFocus="AddressBar_LostFocus"
                    QuerySubmitted="AddressBar_QuerySubmitted"
                    SuggestionChosen="AddressBar_SuggestionChosen"
                    TextChanged="AddressBar_TextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.TextBoxStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="IsSpellCheckEnabled" Value="False" />
                            <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="CharacterSpacing" Value="1" />
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="12,6,36,4" />
                        </Style>
                    </AutoSuggestBox.TextBoxStyle>
                </AutoSuggestBox>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="AudioToggleButton"
                        l:Uids.Uid="AudioToggleButton"
                        Click="AudioToggleButton_Click"
                        Content="&#xE767;"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Style="{StaticResource AddressBarButtonStyle}">
                        <Button.OpacityTransition>
                            <ScalarTransition />
                        </Button.OpacityTransition>
                    </Button>

                    <Button
                        x:Name="RefreshButton"
                        l:Uids.Uid="RefreshButton"
                        Click="RefreshButton_Click"
                        Content="&#xE72C;"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Foreground="{ThemeResource TextControlButtonForeground}"
                        Style="{StaticResource AddressBarButtonStyle}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="0,2"
                    CornerRadius="8"
                    IsHitTestVisible="False">
                    <ProgressBar
                        x:Name="LoadingProgressBar"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        IsIndeterminate="False"
                        Maximum="100"
                        Minimum="0">
                        <ProgressBar.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.2" />
                        </ProgressBar.OpacityTransition>
                    </ProgressBar>
                </Border>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,2,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">

                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <Button
                        x:Name="DevToolsButton"
                        Padding="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ClickMode="Release"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Style="{StaticResource AppBarButtonStyle}">

                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Glyph="&#xEBE8;"
                            Translation="0,0,0">
                            <FontIcon.TranslationTransition>
                                <Vector3Transition />
                            </FontIcon.TranslationTransition>
                        </FontIcon>

                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="ShowPageSelector"
                                    Click="ShowPageSelector_Click"
                                    Text="Show page selector">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="DownloadsButton"
                        Padding="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ClickMode="Release"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Style="{StaticResource AppBarButtonStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Name="DownloadingIcon" Visibility="Collapsed">
                                <PathIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource SmallDown}"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <ProgressRing
                                    Name="DownloadProgress"
                                    Width="18"
                                    Height="18"
                                    Background="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                    IsIndeterminate="False"
                                    Value="50" />
                            </Grid>

                            <PathIcon
                                Name="DownloadComplete"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource DownloadFullEllipse}"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />

                            <FontIcon
                                Name="DownloadIcon"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18"
                                Glyph="&#xE896;" />

                            <!--<PathIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource LongDown}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <ProgressBar
                                Grid.Row="1"
                                Width="18"
                                Margin="0,4,0,0"
                                Value="54" />-->
                        </Grid>

                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <my:ContentMenuFlyoutItem MinWidth="400">
                                    <StackPanel>
                                        <Grid>
                                            <!--  Settings page already has a text that says "downloads", so it's named "DownloadsSection"  -->
                                            <TextBlock l:Uids.Uid="DownloadsSection" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <Grid l:Uids.Uid="ClearCompletedGrid">
                                                <Button
                                                    Name="ClearCompletedButton"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    l:Uids.Uid="ClearCompletedButton"
                                                    Click="ClearCompletedButton_Click"
                                                    IsEnabled="False"
                                                    Style="{StaticResource SmallButtonStyle}" />
                                            </Grid>

                                            <ListView
                                                x:Name="DownloadsList"
                                                MaxHeight="400"
                                                Margin="0,27,0,0"
                                                IsItemClickEnabled="False"
                                                ItemsSource="{x:Bind Downloads}"
                                                SelectionMode="None">

                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="-16,8,-12,0"
                                                            Padding="12"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}">

                                                            <Grid>
                                                                <Grid.ContextFlyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem l:Uids.Uid="RemoveFromList" Click="RemoveFromList_Click">
                                                                            <MenuFlyoutItem.Icon>
                                                                                <FontIcon Glyph="&#xE894;" />
                                                                            </MenuFlyoutItem.Icon>
                                                                        </MenuFlyoutItem>
                                                                    </MenuFlyout>
                                                                </Grid.ContextFlyout>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Image
                                                                    x:Name="FileIcon"
                                                                    Width="28"
                                                                    Height="28"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Source="{Binding Icon}"
                                                                    Visibility="{Binding Icon, Converter={StaticResource ValueToVisibilityConverter}}" />

                                                                <FontIcon
                                                                    Name="FilePlaceholder"
                                                                    Glyph="&#xE7C3;"
                                                                    Visibility="{Binding Icon, Converter={StaticResource ValueToVisibilityConverter}, ConverterParameter=Invert}" />

                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Margin="14,0,12,0"
                                                                    Spacing="6">
                                                                    <TextBlock
                                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                        Text="{Binding FileName}"
                                                                        TextTrimming="CharacterEllipsis" />

                                                                    <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Progress}" />

                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                                        Text="{Binding Status}" />
                                                                </StackPanel>

                                                                <Button
                                                                    Name="MainButton"
                                                                    Grid.Column="2"
                                                                    Width="32"
                                                                    Height="32"
                                                                    Padding="4"
                                                                    Click="MainButton_Click"
                                                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                    Style="{StaticResource AppBarButtonStyle}">
                                                                    <FontIcon FontSize="14" Glyph="{Binding MainButtonGlyph}" />
                                                                </Button>
                                                            </Grid>

                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>

                                        <TextBlock
                                            x:Name="NoDownloadsText"
                                            Margin="0,32,0,18"
                                            HorizontalAlignment="Center"
                                            l:Uids.Uid="NoDownloadsText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </my:ContentMenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="MoreButton"
                        Padding="6"
                        ClickMode="Release"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Style="{StaticResource AppBarButtonStyle}">

                        <ToolTipService.ToolTip>
                            <StackPanel>
                                <TextBlock
                                    l:Uids.Uid="MoreButtonTooltipTitle"
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock l:Uids.Uid="MoreButtonTooltipDescription" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </ToolTipService.ToolTip>

                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Glyph="&#xE712;"
                            Translation="0,0,0">
                            <FontIcon.TranslationTransition>
                                <Vector3Transition />
                            </FontIcon.TranslationTransition>
                        </FontIcon>

                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">

                                <!--  Navigation / Tab  -->
                                <MenuFlyoutItem
                                    x:Name="NewTabMenuItem"
                                    MinWidth="178"
                                    l:Uids.Uid="NewTabMenuItem"
                                    Click="NewTabMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    x:Name="DuplicateTabMenuItem"
                                    l:Uids.Uid="DuplicateTabMenuItem"
                                    Click="DuplicateTabMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB91;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <!--  Page actions  -->
                                <MenuFlyoutItem
                                    x:Name="ZoomInMenuItem"
                                    l:Uids.Uid="ZoomInMenuItem"
                                    Click="ZoomInMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    x:Name="ZoomOutMenuItem"
                                    l:Uids.Uid="ZoomOutMenuItem"
                                    Click="ZoomOutMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    x:Name="ResetZoomMenuItem"
                                    l:Uids.Uid="ResetZoomMenuItem"
                                    Click="ResetZoomMenuItem_Click" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="FindMenuItem"
                                    l:Uids.Uid="FindMenuItem"
                                    Click="FindMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE721;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    x:Name="PrintMenuItem"
                                    l:Uids.Uid="PrintMenuItem"
                                    Click="PrintMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE749;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <!--  Dev / Info  -->
                                <MenuFlyoutItem
                                    x:Name="ViewSourceMenuItem"
                                    l:Uids.Uid="ViewSourceMenuItem"
                                    Click="ViewSourceMenuItem_Click" />

                                <MenuFlyoutItem
                                    x:Name="DevToolsMenuItem"
                                    l:Uids.Uid="DevToolsMenuItem"
                                    Click="DevToolsMenuItem_Click" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="SettingsMenuItem"
                                    l:Uids.Uid="SettingsMenuItem"
                                    Click="SettingsButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  smart, right?  -->

            <Rectangle
                Grid.Row="1"
                Height="1"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource TabViewBorderBrush}"
                IsHitTestVisible="False" />

            <Rectangle
                x:Name="RightTabViewRectangle"
                Width="64"
                HorizontalAlignment="Right" />

            <Rectangle
                Grid.Row="1"
                Width="64"
                Height="1"
                Margin="0,-1,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Fill="{ThemeResource TabViewBorderBrush}"
                IsHitTestVisible="False" />
        </Grid>

        <!--  CURRENT TAB CONTENT  -->
        <ContentPresenter x:Name="CurrentTabContent" Grid.Row="1" />

        <Border
            x:Name="StatusBarBorder"
            Grid.Row="1"
            Margin="6,6"
            Padding="6,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            IsHitTestVisible="False"
            Opacity="0">

            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>

            <TextBlock
                x:Name="StatusBar"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

        </Border>

    </Grid>
</Window>
