<Page
    x:Class="FluentBrowser.Pages.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:FluentBrowser.Pages"
    xmlns:my="using:FluentBrowser.Controls"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid x:Name="RootGrid">
        <ScrollView Padding="24,0" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="1"
                    Margin="0,48"
                    HorizontalAlignment="Stretch">

                    <StackPanel x:Name="FavoritesCard">
                        <TextBlock
                            x:Name="FavoritesTitle"
                            l:Uids.Uid="FavoritesTitle"
                            Style="{ThemeResource TitleTextBlockStyle}" />

                        <ListView
                            x:Name="FavoritesListView"
                            Margin="0,18"
                            ItemsSource="{x:Bind Favorites, Mode=OneWay}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel
                                        HorizontalAlignment="Left"
                                        HorizontalSpacing="12"
                                        VerticalSpacing="12" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border
                                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}" />

                                        <Button
                                            Width="84"
                                            Height="84"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Click="FavoriteButton_Click"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Style="{ThemeResource AppBarButtonStyle}"
                                            ToolTipService.ToolTip="{Binding Name}">
                                            <Image
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{Binding Favicon32}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollView>

        <Button
            Width="32"
            Height="32"
            Margin="0,0,12,12"
            Padding="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Style="{ThemeResource AppBarButtonStyle}">

            <AnimatedIcon x:Name="SettingsIcon">
                <AnimatedIcon.Style>
                    <Style TargetType="AnimatedIcon">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Style>
                </AnimatedIcon.Style>
                <AnimatedIcon.Source>
                    <a:AnimatedSettingsVisualSource />
                </AnimatedIcon.Source>
                <AnimatedIcon.FallbackIconSource>
                    <SymbolIconSource Symbol="Find" />
                </AnimatedIcon.FallbackIconSource>
            </AnimatedIcon>

            <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight">
                    <my:ContentMenuFlyoutItem Width="550">
                        <StackPanel Spacing="3">
                            <TextBlock Margin="0,0,0,8" l:Uids.Uid="CustomizeStartPageHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                            <controls:SettingsCard l:Uids.Uid="FavoritesTitle">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE734;" />
                                </controls:SettingsCard.HeaderIcon>

                                <ToggleSwitch
                                    x:Name="FavoritesToggleSwitch"
                                    l:Uids.Uid="General_ToggleSwitch" />
                            </controls:SettingsCard>

                            <my:SettingsControl
                                x:Name="BackgroundModeCard"
                                l:Uids.Uid="StartPageBackgroundSetting"
                                IsExpander="True">

                                <my:SettingsControl.HeaderIcon>
                                    <FontIcon Glyph="&#xE91B;" />
                                </my:SettingsControl.HeaderIcon>

                                <my:SettingsControl.Description>
                                    <TextBlock x:Name="RandomBackgroundDescription" Visibility="Collapsed" />
                                </my:SettingsControl.Description>

                                <ComboBox x:Name="BackgroundModeComboBox" SelectedIndex="0">
                                    <ComboBoxItem l:Uids.Uid="ImageBackgroundOption" Tag="Image" />
                                    <ComboBoxItem l:Uids.Uid="RandomBackgroundOption" Tag="Random" />
                                    <ComboBoxItem l:Uids.Uid="NoneBackgroundOption" Tag="None" />
                                </ComboBox>

                                <my:SettingsControl.Items>
                                    <controls:SettingsCard BorderThickness="0">
                                        <ItemsView
                                            x:Name="RecentBackgroundsItemsView"
                                            Width="494"
                                            Height="72"
                                            Margin="-42,-6,0,-16"
                                            ItemsSource="{x:Bind RecentBackgrounds, Mode=OneWay}"
                                            Loaded="RecentBackgroundsItemsView_Loaded"
                                            SelectionChanged="RecentBackgroundsItemsView_SelectionChanged"
                                            SelectionMode="Single"
                                            Visibility="Visible">

                                            <ItemsView.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" />
                                            </ItemsView.Layout>

                                            <ItemsView.ItemTemplate>
                                                <DataTemplate x:DataType="local:BackgroundImageItem">
                                                    <ItemContainer
                                                        Width="96"
                                                        Height="64"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="{x:Bind FilePath}">

                                                        <Grid>
                                                            <Button
                                                                Width="96"
                                                                Height="64"
                                                                Padding="0"
                                                                Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
                                                                BorderThickness="0"
                                                                Click="AddBackgroundButton_Click"
                                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                Visibility="{x:Bind AddButtonVisibility}">
                                                                <Button.Resources>
                                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="LayerOnMicaBaseAltFillColorTransparentBrush" />
                                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="LayerOnMicaBaseAltFillColorTertiaryBrush" />
                                                                </Button.Resources>

                                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                            </Button>

                                                            <Image
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.AccessibilityView="Raw"
                                                                Source="{x:Bind Thumbnail}"
                                                                Stretch="UniformToFill"
                                                                Visibility="{x:Bind ImageVisibility}">

                                                                <Image.ContextFlyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem
                                                                            l:Uids.Uid="DeleteItem"
                                                                            Click="DeleteBackgroundMenuFlyoutItem_Click"
                                                                            Tag="{x:Bind FilePath}">
                                                                            <MenuFlyoutItem.Icon>
                                                                                <FontIcon Glyph="&#xE74D;" />
                                                                            </MenuFlyoutItem.Icon>
                                                                        </MenuFlyoutItem>
                                                                    </MenuFlyout>
                                                                </Image.ContextFlyout>
                                                            </Image>
                                                        </Grid>
                                                    </ItemContainer>
                                                </DataTemplate>
                                            </ItemsView.ItemTemplate>
                                        </ItemsView>
                                    </controls:SettingsCard>
                                </my:SettingsControl.Items>
                            </my:SettingsControl>
                        </StackPanel>
                    </my:ContentMenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <Button
            x:Name="InfoButton"
            Width="32"
            Height="32"
            Margin="12,0,0,12"
            Padding="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Style="{ThemeResource AppBarButtonStyle}">

            <FontIcon
                x:Name="InfoIcon"
                FontSize="15"
                Glyph="&#xE946;" />

            <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft">
                    <my:ContentMenuFlyoutItem Width="500">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Margin="0,0,0,8"
                                l:Uids.Uid="ImageInfoHeader"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />

                            <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                                <StackPanel x:Name="DescriptionField">
                                    <TextBlock
                                        l:Uids.Uid="ImageDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />

                                    <TextBlock
                                        x:Name="DescriptionTextBlock"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel x:Name="CreatorField">
                                    <TextBlock
                                        l:Uids.Uid="ImageCreator"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />

                                    <TextBlock
                                        x:Name="CreatorTextBlock"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel x:Name="DateField">
                                    <TextBlock
                                        l:Uids.Uid="ImageDate"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />

                                    <TextBlock
                                        x:Name="DateTextBlock"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel x:Name="LicenseField">
                                    <TextBlock
                                        l:Uids.Uid="ImageLicense"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />

                                    <TextBlock IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                        <Run x:Name="LicenseRun" />
                                        <Run Text="·" />
                                        <Hyperlink x:Name="LicenseLink" UnderlineStyle="None">
                                            <Run l:Uids.Uid="ViewLicenseHyperlink" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </controls:WrapPanel>
                        </StackPanel>
                    </my:ContentMenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Page>