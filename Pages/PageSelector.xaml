<Page
    x:Class="FluentBrowser.Pages.PageSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <InfoBar
                Title="This is a debug page!"
                Margin="24,14,24,16"
                IsClosable="True"
                IsOpen="True"
                Message="This page is for testing and development only. Translations aren't supported here, so everything you see on this page is in English. Why? Well, there's really not much of a point in translating all of this by hand when this page is only here for testing things anyway, and most of the content here probably wouldn't make much sense when translated either. So yeah, don't expect everything to be translated, but you can still interact with the pages normally and test everything just like you would anywhere else in the app. I don't know why I keep making this message longer, it's just funny to me. Though I do have to look at it every time I want to test something. By the way, how's your day? Mine's been really good. What's that? I couldn't really hear you. Sorry? Pardon? Que?"
                Severity="Warning" />

            <controls:WrapPanel
                Margin="36,0,36,0"
                HorizontalSpacing="12"
                VerticalSpacing="12">
                <ComboBox
                    x:Name="PageComboBox"
                    DisplayMemberPath="Name"
                    Header="Select a page"
                    SelectionChanged="PageComboBox_SelectionChanged" />

                <ComboBox
                    x:Name="ErrorStatusComboBox"
                    DisplayMemberPath="Name"
                    Header="Error status" />

                <TextBox
                    x:Name="UrlTextBox"
                    Header="URL"
                    Text="https://example.invalid" />
            </controls:WrapPanel>

            <Button
                x:Name="NavigateButton"
                Margin="36,16,36,0"
                HorizontalAlignment="Left"
                Click="NavigateButton_Click"
                Content="Navigate"
                Style="{ThemeResource AccentButtonStyle}" />

            <Rectangle
                Height="1"
                Margin="0,24,0,0"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </StackPanel>

        <Frame x:Name="ContentFrame" Grid.Row="1">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Page>